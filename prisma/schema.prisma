generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clients {
  id        Int    @id @default(autoincrement())
  uid       String @db.Uuid
  firstName String
  lastName  String
  model     String
  mileage   Int
  vin       String @unique
}
